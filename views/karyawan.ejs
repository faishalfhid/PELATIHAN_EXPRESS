<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Data Karyawan</title>
  <link rel="stylesheet" href="/css/bootstrap.min.css">
</head>

<body>
  <%- include('partials/navbar') %>
  <div class="container mt-5 min-vh-100">
    <h2>Manajemen Karyawan</h2>
    <a href="/karyawan/tambah" class="btn btn-primary mb-3">Tambah karyawan</a>
    <table class="table table-striped table-bordered border-warning">
      <thead>
        <tr class="table-warning">
          <th>ID</th>
          <th>Nama Karyawan</th>
          <th>Divisi</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (listKaryawan.length === 0) { %>
        <tr>
          <td colspan="4">Belum ada karyawan.</td>
        </tr>
        <% } %>
        <% listKaryawan.forEach(function(karyawan){ %>
        <tr>
          <td><%= karyawan.id %></td>
          <td><%= karyawan.nama %></td>
          <td><%= karyawan.divisi %></td>
          <td>
              <a href="/karyawan/edit/<%= karyawan.id %>" class="btn btn-warning btn-sm">Edit</a>
              <form action="/karyawan/hapus/<%= karyawan.id %>" method="POST" class="d-inline" onsubmit="return confirm('Yakin hapus karyawan ini?')">
                <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
              </form>
            </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <a type="button" href="/" class="btn btn-warning">Kembali</a>
  </div>
</body>
<%- include('partials/footer') %>

</html>